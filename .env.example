# --- Syntaris runtime mode ---
SYNTARIS_ENV=development
SYNTARIS_CONFIG_PATH=./config/syntaris.example.toml

# --- External LLM runtime (must stay outside this repository) ---
SYNTARIS_LLM_SERVER_BIN=
SYNTARIS_LLM_MODEL_PATH=
SYNTARIS_LLM_HOST=127.0.0.1
SYNTARIS_LLM_PORT=8080

# --- Local persistence paths ---
SYNTARIS_DATA_DIR=./.syntaris
SYNTARIS_DB_PATH=./.syntaris/runtime.db

# --- Reply backend ---
# deterministic | llama-http
SYNTARIS_REPLY_BACKEND=deterministic
SYNTARIS_REPLY_LIVE_URL=http://127.0.0.1:8080
SYNTARIS_REPLY_LIVE_MODEL=
SYNTARIS_REPLY_TIMEOUT_SECONDS=10
